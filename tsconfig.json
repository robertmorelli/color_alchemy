{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "outDir": "artifacts/scripts",
    "strict": true,
    "esModuleInterop": true,
    "lib": [
      "dom",
      "dom.iterable",
      "ESNext",
      "WebWorker",
    ],
    "skipLibCheck": true,
    "types": [
      "@types/web",
      "@types/wicg-file-system-access"
    ]
  },
  "include": [
    "src/**/*"
  ]
}
